# Telegram
BOT_TOKEN=your_telegram_bot_token
CHANNEL_ID=-100xxxxxxxxxx
ADMIN_USERNAME=your_telegram_username
ADMIN_ID=your_telegram_numeric_id

# AI — Groq (бесплатно: console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# AI-критик — Google Gemini (бесплатно, без карты: aistudio.google.com/apikey)
# ДРУГАЯ модель, не Groq — нужна для реального расхождения мнений при
# проверке рекомендаций. Если не задан — бот работает без критика, просто
# публикует рекомендацию Apollo (Groq) без второго мнения.
GEMINI_API_KEY=AIzaSyxxxxxxxxx

# Антидубль — Upstash Redis (бесплатно: upstash.com, без карты)
# Получить: upstash.com → Redis → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# Фото — Google Custom Search (бесплатно: 100 запросов/день)
GOOGLE_CSE_API_KEY=AIzaSyxxxxxxxxx
GOOGLE_CSE_CX=xxxxxxxxxxxxxxxxx

# Фото — опционально (если нет ключей — источник пропускается)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional Telegram forum group (keeps CHANNEL_ID as fallback)
GROUP_CHAT_ID=

# Optional Telegram User API monitor
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_MONITOR_CHANNELS=
